{
    "scripts": {
        "check:publish": "tsx scripts/check-publish.ts",
        "check:output": "tsx scripts/check-publish.ts --scan-output",
        "sync": "tsx scripts/sync-from-shared-docs.ts",
        "prebuild": "tsx scripts/sync-from-shared-docs.ts && tsx scripts/check-publish.ts",
        "symlink-docs": "tsx scripts/symlink-project-docs.ts",
        "build": "npm run prebuild && npm run symlink-docs && npm run check:output",
        "dev": "npm run build",
        "smoke": "node scripts/smoke.mjs"
    },
    "devDependencies": {
        "@types/node": "^25.2.0",
        "js-yaml": "^4.1.0",
        "tsx": "^4.7.0"
    }
}
