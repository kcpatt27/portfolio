                    dotClass = 'bg-amber-400 animate-pulse';
                } else if (agent.status === 'PAUSED') {
                    statusBadgeClass = 'bg-zinc-800 text-zinc-400 border-zinc-700';
                    dotClass = 'bg-zinc-500';
                } else if (agent.status === 'KILLED') {
