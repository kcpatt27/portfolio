                // Card Element
                const card = document.createElement('div');
                card.onclick = () => selectAgent(agent.id);

                if (state.viewMode === 'carousel') {
                    card.className = `flex-shrink-0 w-64 snap-start p-2.5 rounded border transition-all cursor-pointer ${
