                        : 'bg-brand-card border-brand-border hover:border-zinc-700'
                    }`;

                    card.innerHTML = `
                        <div class="flex items-center justify-between mb-1.5">
                            <div class="flex items-center space-x-2 truncate">
                                <span class="w-2 h-2 rounded-full ${dotClass}"></span>
                                <span class="font-mono text-xs font-semibold text-white truncate">${agent.name}</span>
                            </div>
                            <span class="text-[9px] font-mono px-1.5 py-0.2 rounded border ${statusBadgeClass}">${agent.status}</span>
                        </div>

                        <div class="text-[10px] text-zinc-400 truncate font-mono mb-2">${agent.role}</div>

                        <div class="grid grid-cols-2 gap-1 text-[10px] font-mono mb-2 bg-black/60 p-1.5 rounded border border-zinc-900">
                            <div>
                                <span class="text-zinc-500 block">MEM</span>
                                <span class="text-zinc-200 font-semibold">${agent.memory}</span>
                            </div>
                            <div>
                                <span class="text-zinc-500 block">THROUGHPUT</span>
                                <span class="text-emerald-400 font-semibold mono-num">${agent.throughput} t/s</span>
                            </div>
                        </div>

                        <!-- Sparkline Canvas Container -->
                        <div class="h-6 w-full flex items-end">
                            <canvas id="sparkline-${agent.id}" class="w-full h-full"></canvas>
                        </div>
                    `;
                } else {
                    // Compact View
                    card.className = `w-full p-2 rounded border flex items-center justify-between transition-all cursor-pointer ${
                        isSelected 
                        ? 'bg-brand-surface border-emerald-500/80' 
                        : 'bg-brand-card border-brand-border hover:border-zinc-700'
                    }`;

                    card.innerHTML = `
                        <div class="flex items-center space-x-2.5 min-w-0">
                            <span class="w-2 h-2 rounded-full ${dotClass}"></span>
                            <div class="truncate">
                                <div class="font-mono text-xs font-semibold text-white truncate">${agent.name}</div>
                                <div class="text-[10px] text-zinc-500 font-mono truncate">${agent.model}</div>
                            </div>
                        </div>

                        <div class="flex items-center space-x-3 text-[10px] font-mono">
                            <span class="text-emerald-400 hidden sm:inline">${agent.throughput} t/s</span>
                            <span class="text-[9px] px-1.5 py-0.2 rounded border ${statusBadgeClass}">${agent.status}</span>
                        </div>
                    `;
                }

                container.appendChild(card);

                // Draw Sparkline Graph after render
                if (state.viewMode === 'carousel') {
                    setTimeout(() => drawSparkline(`sparkline-${agent.id}`, agent.history, agent.status === 'KILLED' ? '#f43f5e' : '#10b981'), 10);
                }
            });

            // Update Total Agent Counter
            document.getElementById('total-agents-badge').innerText = state.agents.length;
            
            // Count Live/Thinking Agents
            const activeCount = state.agents.filter(a => a.status === 'RUNNING' || a.status === 'THINKING').length;
            document.getElementById('live-agent-count').innerText = `${activeCount} ACTV`;
        }

        // Draw Dynamic Sparkline Canvas
        function drawSparkline(canvasId, data, strokeColor = '#10b981') {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            
            // Canvas Sizing Fix
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * 2;
            canvas.height = rect.height * 2;
            ctx.scale(2, 2);

            const width = rect.width;
            const height = rect.height;

            ctx.clearRect(0, 0, width, height);

            if (data.length < 2) return;

            const max = Math.max(...data, 100);
            const min = 0;
            const step = width / (data.length - 1);

            ctx.beginPath();
            ctx.strokeStyle = strokeColor;
            ctx.lineWidth = 1.5;

            data.forEach((val, i) => {
                const x = i * step;
                const y = height - ((val - min) / (max - min)) * height;
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            });

            ctx.stroke();

            // Fill Gradient under sparkline
            ctx.lineTo(width, height);
            ctx.lineTo(0, height);
            ctx.closePath();
            const grad = ctx.createLinearGradient(0, 0, 0, height);
            grad.addColorStop(0, strokeColor === '#f43f5e' ? 'rgba(244, 63, 94, 0.2)' : 'rgba(16, 185, 129, 0.2)');
            grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
            ctx.fillStyle = grad;
            ctx.fill();
        }

        // Select Agent & Sync Control Center
        function selectAgent(agentId) {
            state.selectedAgentId = agentId;
            const agent = state.agents.find(a => a.id === agentId);
            if (!agent) return;

            // Sync Control Panel Fields
            document.getElementById('ctrl-agent-name').innerText = agent.name;
            document.getElementById('ctrl-agent-role').innerText = `Goal: ${agent.role}`;
            document.getElementById('ctrl-agent-status').innerText = agent.status;
            document.getElementById('ctrl-model-tag').innerText = agent.model;

            // Update Status Badge Styling
            const statusBadge = document.getElementById('ctrl-agent-status');
            const dot = document.getElementById('selected-agent-indicator');

            if (agent.status === 'RUNNING') {
                statusBadge.className = 'bg-emerald-950/80 text-emerald-400 border border-emerald-800/60 text-[10px] font-mono px-1.5 py-0.5 rounded';
                dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500';
            } else if (agent.status === 'THINKING') {
                statusBadge.className = 'bg-amber-950/80 text-amber-400 border border-amber-800/60 text-[10px] font-mono px-1.5 py-0.5 rounded';
                dot.className = 'w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse';
            } else if (agent.status === 'PAUSED') {
                statusBadge.className = 'bg-zinc-800 text-zinc-400 border border-zinc-700 text-[10px] font-mono px-1.5 py-0.5 rounded';
                dot.className = 'w-2.5 h-2.5 rounded-full bg-zinc-500';
            } else if (agent.status === 'KILLED') {
                statusBadge.className = 'bg-rose-950/80 text-rose-400 border border-rose-800/60 text-[10px] font-mono px-1.5 py-0.5 rounded';
                dot.className = 'w-2.5 h-2.5 rounded-full bg-rose-500';
            }

            // Sync Parameter Sliders
            document.getElementById('input-temp').value = agent.temp;
            document.getElementById('val-temp').innerText = agent.temp.toFixed(2);
            document.getElementById('badge-temp').innerText = agent.temp.toFixed(2);

            document.getElementById('input-top-p').value = agent.topP;
            document.getElementById('val-top-p').innerText = agent.topP.toFixed(2);
            document.getElementById('badge-top-p').innerText = agent.topP.toFixed(2);

            document.getElementById('input-tokens').value = agent.tokens;
            document.getElementById('val-tokens').innerText = agent.tokens.toLocaleString();

            // Sync Pause / Resume Button Label
            const pauseBtnText = document.getElementById('pause-text');
            const pauseIcon = document.getElementById('pause-icon');
            if (agent.status === 'PAUSED') {
                pauseBtnText.innerText = 'RESUME';
                pauseIcon.setAttribute('data-lucide', 'play');
            } else {
                pauseBtnText.innerText = 'PAUSED';
                pauseIcon.setAttribute('data-lucide', 'pause');
            }

            // Reset Kill switch confirmation stage
            resetKillSwitchBtn();

            renderAgents();
            lucide.createIcons();
        }

        // Kill Switch Double-Tap Safeguard Handler
        function handleKillSwitch() {
            const agent = state.agents.find(a => a.id === state.selectedAgentId);
            if (!agent) return;

            const btn = document.getElementById('kill-switch-btn');
            const text = document.getElementById('kill-switch-text');

            if (state.killSwitchStage === 0) {
                // First Tap - Prompt Confirmation
                state.killSwitchStage = 1;
                text.innerText = 'CONFIRM KILL?';
                btn.className = 'flex items-center space-x-1.5 bg-rose-600 hover:bg-rose-500 text-white font-mono font-bold px-3 py-1.5 rounded transition-all animate-pulse';

                // Reset stage after 3.5 seconds if unconfirmed
                setTimeout(() => {
                    if (state.killSwitchStage === 1) resetKillSwitchBtn();
                }, 3500);

            } else if (state.killSwitchStage === 1) {
                // Second Tap - Execute Immediate Termination
                agent.status = 'KILLED';
                agent.throughput = 0;
                agent.history.push(0);

                // Add Kill Event Log to Stream
                addLog('CRITICAL', `[EMERGENCY_KILL] Process SIGKILL issued to agent ${agent.name}. Thread terminated.`);

                selectAgent(agent.id);
                resetKillSwitchBtn();
            }
        }

        function resetKillSwitchBtn() {
            state.killSwitchStage = 0;
            const btn = document.getElementById('kill-switch-btn');
            const text = document.getElementById('kill-switch-text');
            text.innerText = 'KILL SWITCH';
            btn.className = 'flex items-center space-x-1.5 bg-rose-950/40 hover:bg-rose-900/60 text-rose-300 border border-rose-800/70 text-xs font-mono font-semibold px-3 py-1.5 rounded transition-all';
        }

        // Toggle Pause / Resume
        function togglePauseAgent() {
            const agent = state.agents.find(a => a.id === state.selectedAgentId);
            if (!agent || agent.status === 'KILLED') return;

            if (agent.status === 'PAUSED') {
                agent.status = 'RUNNING';
                agent.throughput = 1420;
                addLog('SYS_INFO', `[STATE_CHANGE] Resumed execution thread for ${agent.name}`);
            } else {
                agent.status = 'PAUSED';
                agent.throughput = 0;
                addLog('WARNING', `[STATE_CHANGE] Execution thread paused for ${agent.name}`);
            }

            selectAgent(agent.id);
        }

        // Parameter Override Sliders Handler
        function updateParam(type, val) {
            const agent = state.agents.find(a => a.id === state.selectedAgentId);
            if (!agent) return;

            if (type === 'temp') {
                const num = parseFloat(val);
                agent.temp = num;
                document.getElementById('val-temp').innerText = num.toFixed(2);
                document.getElementById('badge-temp').innerText = num.toFixed(2);
            } else if (type === 'top-p') {
                const num = parseFloat(val);
                agent.topP = num;
                document.getElementById('val-top-p').innerText = num.toFixed(2);
                document.getElementById('badge-top-p').innerText = num.toFixed(2);
            } else if (type === 'tokens') {
                const num = parseInt(val);
                agent.tokens = num;
                document.getElementById('val-tokens').innerText = num.toLocaleString();
            }
        }

        function updateTools() {
            const agent = state.agents.find(a => a.id === state.selectedAgentId);
            if (!agent) return;

            const activeTools = [];
            if (document.getElementById('tool-bash').checked) activeTools.push('BASH');
            if (document.getElementById('tool-web').checked) activeTools.push('WEB');
            if (document.getElementById('tool-ast').checked) activeTools.push('AST');
            if (document.getElementById('tool-db').checked) activeTools.push('SQL');

            agent.tools = activeTools;
            document.getElementById('badge-tools').innerText = activeTools.join(', ') || 'NONE';
        }

        function resetParams() {
            updateParam('temp', 0.20);
            updateParam('top-p', 0.90);
            updateParam('tokens', 4096);
            document.getElementById('input-temp').value = 0.20;
            document.getElementById('input-top-p').value = 0.90;
            document.getElementById('input-tokens').value = 4096;
        }

        // Add Log Entry & Stream Rerender
        function addLog(type, text) {
            const now = new Date();
            const timeStr = `${now.getHours().toString().padStart(2,'0')}:${now.getMinutes().toString().padStart(2,'0')}:${now.getSeconds().toString().padStart(2,'0')}.${now.getMilliseconds().toString().padStart(3,'0')}`;
            
            state.logs.push({ ts: timeStr, type, text });

            // Limit buffer size to 150 lines
            if (state.logs.length > 150) state.logs.shift();

            renderLogs();
        }

        function renderLogs() {
            const feed = document.getElementById('terminal-feed');
            const searchVal = state.logFilter.toLowerCase();

            const filtered = state.logs.filter(l => 
                l.text.toLowerCase().includes(searchVal) || l.type.toLowerCase().includes(searchVal)
            );

            feed.innerHTML = filtered.map(log => {
                let badgeStyle = 'text-zinc-400';
                if (log.type === 'THOUGHT') badgeStyle = 'text-blue-400 font-semibold';
                else if (log.type === 'TOOL_EXEC') badgeStyle = 'text-emerald-400 font-semibold';
                else if (log.type === 'MEMORY_WRITE' || log.type === 'MEMORY_READ') badgeStyle = 'text-purple-400';
                else if (log.type === 'WARNING') badgeStyle = 'text-amber-400 font-bold';
                else if (log.type === 'CRITICAL') badgeStyle = 'text-rose-400 font-bold bg-rose-950/40 px-1 rounded';

                return `<div class="flex items-start space-x-2 leading-relaxed hover:bg-zinc-900/60 p-0.5 rounded transition-colors">
                    <span class="text-zinc-600 select-none font-mono text-[10px]">${log.ts}</span>
                    <span class="text-[10px] ${badgeStyle}">[${log.type}]</span>
                    <span class="text-zinc-300 break-all">${escapeHtml(log.text)}</span>
                </div>`;
            }).join('');

            // Update Counter
            document.getElementById('log-counter').innerText = `Showing ${filtered.length} entries`;

            // Auto-scroll logic
            if (state.autoScroll) {
                feed.scrollTop = feed.scrollHeight;
            }
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        function filterLogs() {
            state.logFilter = document.getElementById('log-search').value;
            renderLogs();
        }

        function toggleScrollLock() {
            state.autoScroll = !state.autoScroll;
            const btn = document.getElementById('scroll-lock-btn');
            if (state.autoScroll) {
                btn.className = 'p-1 rounded bg-zinc-900 text-emerald-400 border border-zinc-800 hover:border-zinc-700';
            } else {
                btn.className = 'p-1 rounded bg-zinc-900 text-zinc-500 border border-zinc-800 hover:text-white';
            }
        }

        function copyLogs() {
            const rawText = state.logs.map(l => `[${l.ts}] [${l.type}] ${l.text}`).join('\n');
            const textarea = document.createElement('textarea');
            textarea.value = rawText;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);

            // Subtle Toast Notice
            const btn = event.currentTarget;
            btn.classList.add('text-emerald-400');
            setTimeout(() => btn.classList.remove('text-emerald-400'), 1200);
        }

        function clearLogs() {
            state.logs = [];
            renderLogs();
        }

        // UI Drawers & Modal Handlers
        function toggleParamDrawer() {
            const drawer = document.getElementById('param-drawer');
            drawer.classList.toggle('hidden');
        }

        function toggleBottomDrawer() {
            const content = document.getElementById('tray-content');
            const chevron = document.getElementById('tray-chevron');
            content.classList.toggle('hidden');
            chevron.classList.toggle('rotate-180');
        }

        function closeDeployModal() {
            document.getElementById('deploy-modal').classList.add('hidden');
            document.getElementById('deploy-modal').classList.remove('flex');
        }

        document.getElementById('deploy-modal-btn').addEventListener('click', () => {
            document.getElementById('deploy-modal').classList.remove('hidden');
            document.getElementById('deploy-modal').classList.add('flex');
        });

        // Deploy New Agent Form Submit
        function handleDeploy(e) {
            e.preventDefault();
            const name = document.getElementById('new-agent-name').value.trim().toUpperCase();
            const model = document.getElementById('new-agent-model').value;
            const goal = document.getElementById('new-agent-goal').value.trim();
            const memory = document.getElementById('new-agent-memory').value;

            if (!name || !goal) return;

            const newAgent = {
                id: `agent-${Date.now()}`,
                name: name,
                role: goal,
                status: 'RUNNING',
                model: model,
                memory: `0.4GB / ${memory}`,
                throughput: 1250,
                temp: 0.20,
                topP: 0.90,
                tokens: 4096,
                tools: ['Bash', 'Web Search'],
                history: [10, 20, 30, 45, 60, 80]
            };

            state.agents.unshift(newAgent);
            selectAgent(newAgent.id);
            closeDeployModal();
            addLog('SYS_INFO', `[AGENT_DEPLOYED] Agent ${name} initialized successfully with model ${model}.`);
            
            // Reset form
            document.getElementById('deploy-form').reset();
        }

        // View Mode Switchers
        document.getElementById('view-carousel-btn').addEventListener('click', () => {
            state.viewMode = 'carousel';
            document.getElementById('view-carousel-btn').className = 'p-1 rounded text-zinc-100 bg-zinc-800 transition-colors';
            document.getElementById('view-compact-btn').className = 'p-1 rounded text-zinc-500 hover:text-zinc-300 transition-colors';
            renderAgents();
        });

        document.getElementById('view-compact-btn').addEventListener('click', () => {
            state.viewMode = 'compact';
            document.getElementById('view-compact-btn').className = 'p-1 rounded text-zinc-100 bg-zinc-800 transition-colors';
            document.getElementById('view-carousel-btn').className = 'p-1 rounded text-zinc-500 hover:text-zinc-300 transition-colors';
            renderAgents();
        });

        // Simulated Real-Time Log Generator & Telemetry Pulse
        setInterval(() => {
            const activeAgents = state.agents.filter(a => a.status === 'RUNNING' || a.status === 'THINKING');
            if (activeAgents.length === 0) return;

            // Pick random active agent & generate log
            const agent = activeAgents[Math.floor(Math.random() * activeAgents.length)];
            const template = logTemplates[Math.floor(Math.random() * logTemplates.length)];

            // Append live log
            addLog(template.type, `[${agent.name}] ${template.text}`);

            // Simulate sparkline dynamic update
            const nextVal = Math.floor(Math.random() * 60) + 30;
            agent.history.push(nextVal);
            if (agent.history.length > 18) agent.history.shift();

            // Slightly fluctuate cost & latency telemetry
            document.getElementById('telemetry-latency').innerText = `${Math.floor(Math.random() * 30) + 125}ms`;
            
            const costElem = document.getElementById('cost-rate');
            const currentCost = parseFloat(costElem.innerText.replace('$', '').replace('/min', ''));
            const updatedCost = (currentCost + (Math.random() * 0.0002 - 0.0001)).toFixed(4);
            costElem.innerText = `$${updatedCost}/min`;

            // Redraw sparkline graphs
            if (state.viewMode === 'carousel') {
                drawSparkline(`sparkline-${agent.id}`, agent.history, agent.status === 'KILLED' ? '#f43f5e' : '#10b981');
            }
        }, state.logSpeed);

        // INITIALIZATION
        window.onload = function() {
            renderAgents();
            selectAgent(state.selectedAgentId);
            renderLogs();
            lucide.createIcons();
        };
    </script>
