        // Templates for simulated live streaming logs
        const logTemplates = [
            { type: 'THOUGHT', text: 'Calculating heuristic optimization path for function inline candidates...' },
            { type: 'TOOL_EXEC', text: 'bash -c "pnpm build --filter=@core/router"' },
            { type: 'MEMORY_WRITE', text: 'Persisted execution checkpoint to SQLite state store (#84102)' },
            { type: 'SYS_INFO', text: 'Token throughput burst detected: 2,410 t/s on socket channel 0x4' },
            { type: 'TOOL_EXEC', text: 'curl -X POST https://api.internal/v1/ast/validate' },
            { type: 'THOUGHT', text: 'Verification pass succeeded. Formulating patch summary for git commit...' },
            { type: 'MEMORY_READ', text: 'Retrieved 14 contextual embeddings from vector store cache' },
            { type: 'WARNING', text: 'Context window utilization reached 78% capacity. Compressing history...' }
