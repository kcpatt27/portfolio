<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Autonomous AI Agent Control Panel</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            black: '#000000',
                            surface: '#09090b',
                            card: '#121215',
                            border: '#27272a',
                            subtle: '#18181b',
                            emerald: '#10b981',
                            'emerald-dark': '#059669',
                            amber: '#f59e0b',
                            rose: '#f43f5e',
                            zinc: '#71717a'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
                        mono: ['JetBrains Mono', 'SF Mono', 'Fira Code', 'Consolas', 'monospace']
                    },
                    borderRadius: {
                        'DEFAULT': '3px',
                        'sm': '2px',
                        'md': '3px',
                        'lg': '4px'
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts for JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        /* Custom Industrial Scrollbars */
        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }
        ::-webkit-scrollbar-track {
            background: #09090b;
        }
        ::-webkit-scrollbar-thumb {
            background: #27272a;
            border-radius: 2px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #3f3f46;
        }
        .mono-num {
            font-variant-numeric: tabular-nums;
        }
        .scanline {
            background: linear-gradient(
                to bottom,
                rgba(255,255,255,0),
                rgba(255,255,255,0) 50%,
                rgba(0, 0, 0, 0.2) 50%,
                rgba(0, 0, 0, 0.2)
            );
            background-size: 100% 4px;
        }
        .pulse-subtle {
            animation: pulse-border 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes pulse-border {
            0%, 100% { border-color: rgba(16, 185, 129, 0.4); }
            50% { border-color: rgba(16, 185, 129, 0.9); }
        }
    </style>
</head>
<body class="bg-black text-zinc-100 font-sans antialiased selection:bg-zinc-800 selection:text-white min-h-screen flex flex-col justify-between overflow-x-hidden">

    <!-- STICKY HEADER -->
    <header class="sticky top-0 z-40 bg-brand-surface/90 backdrop-blur-md border-b border-brand-border h-12 px-3 flex items-center justify-between">
        <!-- Left Workspace Switcher & Status Indicator -->
        <div class="flex items-center space-x-2.5 min-w-0">
            <div class="flex items-center space-x-1.5 px-2 py-0.5 rounded border border-brand-border bg-black text-[11px] font-mono text-zinc-300">
                <span class="relative flex h-2 w-2">
                    <span id="global-status-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span id="global-status-dot" class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span class="font-semibold text-zinc-100" id="live-agent-count">3 ACTV</span>
            </div>

            <!-- Workspace Selector Dropdown -->
            <div class="relative min-w-0">
                <select id="workspace-select" class="bg-brand-surface hover:bg-zinc-900 text-zinc-300 text-xs font-mono font-medium rounded border border-brand-border px-2 py-1 pr-6 appearance-none focus:outline-none focus:border-zinc-500 truncate cursor-pointer transition-colors">
                    <option value="us-east-cluster">prod-cluster-us-east / autonomous-v2</option>
                    <option value="eu-central-cluster">prod-cluster-eu-central / deepseek-swarm</option>
                    <option value="sandbox-cluster">dev-sandbox / experimental-rag</option>
                </select>
                <i data-lucide="chevron-down" class="w-3 h-3 text-zinc-500 absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
            </div>
        </div>

        <!-- Right Quick Actions & Notification Bell -->
        <div class="flex items-center space-x-2">
            <button id="deploy-modal-btn" class="flex items-center space-x-1 bg-zinc-100 text-black hover:bg-white text-[11px] font-mono font-semibold px-2.5 py-1 rounded transition-colors">
                <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i>
                <span class="hidden sm:inline">DEPLOY</span>
            </button>
            <button id="notif-btn" class="relative p-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900 border border-transparent hover:border-brand-border transition-all">
                <i data-lucide="bell" class="w-4 h-4"></i>
                <span class="absolute top-1 right-1 w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
            </button>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto p-3 space-y-3 pb-24">
        
        <!-- ACTIVE AGENTS CAROUSEL / LIST CONTAINER -->
        <section class="space-y-2">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-400 font-semibold">Active Agents Swarm</span>
                    <span class="bg-zinc-900 text-zinc-400 border border-brand-border text-[10px] px-1.5 py-0.2 rounded font-mono" id="total-agents-badge">4</span>
                </div>
                
                <!-- Layout Toggle Switches -->
                <div class="flex items-center space-x-1 bg-black p-0.5 rounded border border-brand-border">
                    <button id="view-carousel-btn" class="p-1 rounded text-zinc-100 bg-zinc-800 transition-colors" title="Carousel View">
                        <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i>
                    </button>
                    <button id="view-compact-btn" class="p-1 rounded text-zinc-500 hover:text-zinc-300 transition-colors" title="Compact List View">
                        <i data-lucide="list-filter" class="w-3.5 h-3.5"></i>
                    </button>
                </div>
            </div>

            <!-- Agents Scroll Container -->
            <div id="agents-container" class="flex space-x-2.5 overflow-x-auto pb-2 scrollbar-thin snap-x snap-mandatory">
                <!-- Agent Cards injected via JS -->
            </div>
        </section>

        <!-- THE CONTROL CENTER (PRIMARY FOCUS) -->
        <section class="border border-brand-border bg-brand-surface rounded overflow-hidden">
            <!-- Selected Agent Banner Header -->
            <div class="bg-brand-card border-b border-brand-border p-3 flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center space-x-2.5">
                    <div class="w-2.5 h-2.5 rounded-full bg-emerald-500" id="selected-agent-indicator"></div>
                    <div>
                        <div class="flex items-center space-x-2">
                            <h2 class="text-sm font-semibold font-mono text-white tracking-tight" id="ctrl-agent-name">ARCH-AGENT-01</h2>
                            <span class="bg-emerald-950/80 text-emerald-400 border border-emerald-800/60 text-[10px] font-mono px-1.5 py-0.5 rounded" id="ctrl-agent-status">RUNNING</span>
                        </div>
                        <p class="text-[11px] text-zinc-400 font-mono mt-0.5" id="ctrl-agent-role">Goal: System Architecture Refactoring & AST Parsing</p>
                    </div>
                </div>

                <!-- Emergency Action Group / Kill Switch -->
                <div class="flex items-center space-x-1.5 ml-auto">
                    <button id="pause-resume-btn" onclick="togglePauseAgent()" class="flex items-center space-x-1.5 bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-brand-border text-xs font-mono font-medium px-3 py-1.5 rounded transition-all">
                        <i data-lucide="pause" class="w-3.5 h-3.5 text-amber-400" id="pause-icon"></i>
                        <span id="pause-text">PAUSE</span>
                    </button>
                    
                    <!-- Double-Tap Safeguard Kill Switch -->
                    <button id="kill-switch-btn" onclick="handleKillSwitch()" class="flex items-center space-x-1.5 bg-rose-950/40 hover:bg-rose-900/60 text-rose-300 border border-rose-800/70 text-xs font-mono font-semibold px-3 py-1.5 rounded transition-all">
                        <i data-lucide="skull" class="w-3.5 h-3.5 text-rose-400"></i>
                        <span id="kill-switch-text">KILL SWITCH</span>
                    </button>
                </div>
            </div>

            <!-- Parameters Bar & Overrides Drawer Toggle -->
            <div class="bg-black border-b border-brand-border px-3 py-2 flex items-center justify-between">
                <div class="flex items-center space-x-3 text-[11px] font-mono text-zinc-400 overflow-x-auto py-0.5">
                    <span>MODEL: <strong class="text-zinc-200" id="ctrl-model-tag">claude-3-5-sonnet</strong></span>
                    <span class="text-zinc-700">|</span>
                    <span>TEMP: <strong class="text-zinc-200" id="badge-temp">0.20</strong></span>
                    <span class="text-zinc-700">|</span>
                    <span>TOP_P: <strong class="text-zinc-200" id="badge-top-p">0.90</strong></span>
                    <span class="text-zinc-700">|</span>
                    <span>TOOLS: <strong class="text-emerald-400" id="badge-tools">BASH, AST, GIT</strong></span>
                </div>
                <button id="toggle-params-btn" onclick="toggleParamDrawer()" class="flex items-center space-x-1 text-[11px] font-mono text-zinc-400 hover:text-white transition-colors bg-zinc-900 px-2 py-0.5 rounded border border-brand-border">
                    <i data-lucide="sliders" class="w-3 h-3"></i>
                    <span>TUNE</span>
                </button>
            </div>

            <!-- Parameter Overrides Collapsible Tray -->
            <div id="param-drawer" class="hidden bg-brand-subtle border-b border-brand-border p-3 space-y-3 transition-all">
                <div class="text-[11px] font-mono uppercase text-zinc-400 tracking-wider font-semibold border-b border-zinc-800 pb-1 flex justify-between">
                    <span>Hyperparameter & Tool Overrides</span>
                    <button onclick="resetParams()" class="text-zinc-500 hover:text-zinc-300 underline lowercase">reset defaults</button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <!-- Temperature Slider -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs font-mono">
                            <label class="text-zinc-400">Temperature</label>
                            <span class="text-emerald-400 font-bold" id="val-temp">0.20</span>
                        </div>
                        <input type="range" min="0" max="1" step="0.05" value="0.20" id="input-temp" oninput="updateParam('temp', this.value)" class="w-full h-1 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-emerald-500">
                    </div>

                    <!-- Top-P Slider -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs font-mono">
                            <label class="text-zinc-400">Top-P Sampling</label>
                            <span class="text-emerald-400 font-bold" id="val-top-p">0.90</span>
                        </div>
                        <input type="range" min="0" max="1" step="0.05" value="0.90" id="input-top-p" oninput="updateParam('top-p', this.value)" class="w-full h-1 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-emerald-500">
                    </div>

                    <!-- Max Tokens Slider -->
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs font-mono">
                            <label class="text-zinc-400">Max Output Tokens</label>
                            <span class="text-emerald-400 font-bold" id="val-tokens">4,096</span>
                        </div>
                        <input type="range" min="512" max="16384" step="512" value="4096" id="input-tokens" oninput="updateParam('tokens', this.value)" class="w-full h-1 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-emerald-500">
                    </div>
                </div>

                <!-- Tool Switches -->
                <div class="pt-2 border-t border-zinc-800/80 flex flex-wrap items-center gap-4 text-xs font-mono">
                    <span class="text-zinc-400">Execution Tools:</span>
                    <label class="flex items-center space-x-1.5 cursor-pointer">
                        <input type="checkbox" checked id="tool-bash" onchange="updateTools()" class="rounded bg-zinc-900 border-zinc-700 text-emerald-500 focus:ring-0">
                        <span class="text-zinc-300">Bash Terminal</span>
                    </label>
                    <label class="flex items-center space-x-1.5 cursor-pointer">
                        <input type="checkbox" checked id="tool-web" onchange="updateTools()" class="rounded bg-zinc-900 border-zinc-700 text-emerald-500 focus:ring-0">
                        <span class="text-zinc-300">Web Search</span>
                    </label>
                    <label class="flex items-center space-x-1.5 cursor-pointer">
                        <input type="checkbox" checked id="tool-ast" onchange="updateTools()" class="rounded bg-zinc-900 border-zinc-700 text-emerald-500 focus:ring-0">
                        <span class="text-zinc-300">Code AST Parser</span>
                    </label>
                    <label class="flex items-center space-x-1.5 cursor-pointer">
                        <input type="checkbox" id="tool-db" onchange="updateTools()" class="rounded bg-zinc-900 border-zinc-700 text-emerald-500 focus:ring-0">
                        <span class="text-zinc-300">SQL Write Access</span>
                    </label>
                </div>
            </div>

            <!-- REAL-TIME TERMINAL MICRO-FEED -->
            <div class="relative bg-black font-mono text-[11px]">
                <!-- Terminal Header Control Bar -->
                <div class="flex items-center justify-between px-3 py-1.5 bg-zinc-950 border-b border-brand-border text-zinc-400">
                    <div class="flex items-center space-x-2">
                        <i data-lucide="terminal" class="w-3.5 h-3.5 text-zinc-500"></i>
                        <span class="text-[10px] tracking-wider uppercase text-zinc-300">Syslog Execution Output</span>
                    </div>

                    <!-- Filter Input & Stream Tools -->
                    <div class="flex items-center space-x-2">
                        <div class="relative">
                            <input type="text" id="log-search" placeholder="Filter logs..." onkeyup="filterLogs()" class="bg-zinc-900 text-zinc-200 placeholder-zinc-600 text-[10px] px-2 py-0.5 rounded border border-zinc-800 focus:outline-none focus:border-zinc-600 w-28 sm:w-40">
                        </div>
                        <button id="scroll-lock-btn" onclick="toggleScrollLock()" class="p-1 rounded bg-zinc-900 text-emerald-400 border border-zinc-800 hover:border-zinc-700" title="Auto Scroll Lock">
                            <i data-lucide="arrow-down-to-line" class="w-3 h-3"></i>
                        </button>
                        <button onclick="copyLogs()" class="p-1 rounded bg-zinc-900 text-zinc-400 border border-zinc-800 hover:text-white" title="Copy Log Buffer">
                            <i data-lucide="copy" class="w-3 h-3"></i>
                        </button>
                        <button onclick="clearLogs()" class="p-1 rounded bg-zinc-900 text-zinc-400 border border-zinc-800 hover:text-white" title="Clear Stream">
                            <i data-lucide="trash-2" class="w-3 h-3"></i>
                        </button>
                    </div>
                </div>

                <!-- Live Stream Feed Screen -->
                <div id="terminal-feed" class="h-64 sm:h-72 p-3 overflow-y-auto space-y-1.5 scanline text-zinc-300">
                    <!-- Dynamic Log Items Rendered Here -->
                </div>

                <!-- Terminal Bottom Status Bar -->
                <div class="bg-zinc-950 px-3 py-1 border-t border-brand-border flex items-center justify-between text-[10px] text-zinc-500">
                    <span id="log-counter">Showing 42 entries</span>
                    <span class="flex items-center space-x-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>Stream: <strong class="text-zinc-300 font-semibold" id="stream-speed-label">1.2s</strong></span>
                    </span>
                </div>
            </div>
        </section>
    </main>

    <!-- PERSISTENT BOTTOM TRAY / SYSTEM TELEMETRY -->
    <footer class="fixed bottom-0 left-0 right-0 z-30 bg-brand-surface/95 backdrop-blur-md border-t border-brand-border">
        <!-- Tray Header Toggle / Quick Metrics -->
        <div id="tray-header" onclick="toggleBottomDrawer()" class="px-3 py-2 flex items-center justify-between cursor-pointer hover:bg-zinc-900/50 transition-colors">
            <div class="flex items-center space-x-3 text-[11px] font-mono">
                <!-- Live Cost Metric -->
                <div class="flex items-center space-x-1.5">
                    <i data-lucide="dollar-sign" class="w-3.5 h-3.5 text-emerald-400"></i>
                    <span class="text-zinc-400">Cost Rate:</span>
                    <span class="text-white font-bold mono-num" id="cost-rate">$0.0042/min</span>
                </div>

                <span class="text-zinc-800">|</span>

                <!-- Latency -->
                <div class="flex items-center space-x-1.5">
                    <i data-lucide="activity" class="w-3.5 h-3.5 text-zinc-400"></i>
                    <span class="text-zinc-400">Latency:</span>
                    <span class="text-zinc-200 mono-num" id="telemetry-latency">138ms</span>
                </div>
            </div>

            <div class="flex items-center space-x-2 text-[11px] font-mono text-zinc-400">
                <span class="hidden sm:inline text-zinc-500">Telemetry Details</span>
                <i id="tray-chevron" data-lucide="chevron-up" class="w-4 h-4 transition-transform duration-200"></i>
            </div>
        </div>

        <!-- Collapsible Detailed Telemetry Content -->
        <div id="tray-content" class="hidden border-t border-brand-border p-3 bg-black space-y-3 max-h-60 overflow-y-auto">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-xs font-mono">
                <div class="bg-brand-surface p-2 rounded border border-brand-border">
                    <div class="text-zinc-500 text-[10px] uppercase">Daily Spend Budget</div>
                    <div class="text-sm font-bold text-white mt-0.5">$18.42 / $50.00</div>
                    <div class="w-full bg-zinc-800 h-1.5 rounded-full mt-1.5 overflow-hidden">
                        <div class="bg-emerald-500 h-full w-[36%]"></div>
                    </div>
                </div>

                <div class="bg-brand-surface p-2 rounded border border-brand-border">
                    <div class="text-zinc-500 text-[10px] uppercase">Token Consumption Rate</div>
                    <div class="text-sm font-bold text-emerald-400 mt-0.5">3,820 t/s</div>
                    <div class="text-[10px] text-zinc-500 mt-1">Prompt: 2.1k | Completion: 1.7k</div>
                </div>

                <div class="bg-brand-surface p-2 rounded border border-brand-border">
                    <div class="text-zinc-500 text-[10px] uppercase">Cluster Error Rate</div>
                    <div class="text-sm font-bold text-zinc-200 mt-0.5">0.02%</div>
                    <div class="text-[10px] text-emerald-400 mt-1">Nominal (< 0.50% threshold)</div>
                </div>

                <div class="bg-brand-surface p-2 rounded border border-brand-border">
                    <div class="text-zinc-500 text-[10px] uppercase">WebSocket Channel</div>
                    <div class="text-sm font-bold text-emerald-400 mt-0.5 flex items-center space-x-1">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span>CONNECTED</span>
                    </div>
                    <div class="text-[10px] text-zinc-500 mt-1">wss://agent-mesh.internal</div>
                </div>
            </div>
        </div>
    </footer>

    <!-- INTERACTIVE AGENT DEPLOYMENT MODAL -->
    <div id="deploy-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-3">
        <div class="bg-brand-surface border border-brand-border w-full max-w-lg rounded shadow-2xl overflow-hidden flex flex-col">
            <div class="bg-brand-card px-4 py-3 border-b border-brand-border flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i data-lucide="bot" class="w-4 h-4 text-emerald-400"></i>
                    <h3 class="text-xs font-mono font-semibold text-white tracking-wider uppercase">Deploy Autonomous Agent</h3>
                </div>
                <button onclick="closeDeployModal()" class="text-zinc-500 hover:text-white">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <form id="deploy-form" onsubmit="handleDeploy(event)" class="p-4 space-y-3 font-mono text-xs">
                <div>
                    <label class="block text-zinc-400 mb-1">Agent Identifier Name</label>
                    <input type="text" id="new-agent-name" required placeholder="e.g. DATA-PIPELINE-AGENT-09" class="w-full bg-black border border-brand-border rounded px-3 py-1.5 text-zinc-200 focus:outline-none focus:border-emerald-500">
                </div>

                <div>
                    <label class="block text-zinc-400 mb-1">Target Model Architecture</label>
                    <select id="new-agent-model" class="w-full bg-black border border-brand-border rounded px-3 py-1.5 text-zinc-200 focus:outline-none focus:border-emerald-500">
                        <option value="claude-3-5-sonnet">Claude 3.5 Sonnet (Recommended)</option>
                        <option value="gpt-4o">GPT-4o Omnimodal</option>
                        <option value="deepseek-r1">DeepSeek R1 (Reasoning)</option>
                        <option value="llama-3-3-70b">Llama 3.3 70B Instruct</option>
                    </select>
                </div>

                <div>
                    <label class="block text-zinc-400 mb-1">Goal / System Prompt</label>
                    <textarea id="new-agent-goal" rows="3" required placeholder="Describe autonomous objective..." class="w-full bg-black border border-brand-border rounded p-2.5 text-zinc-200 focus:outline-none focus:border-emerald-500"></textarea>
                </div>

                <div>
                    <label class="block text-zinc-400 mb-1">Allocated Memory Limit</label>
                    <select id="new-agent-memory" class="w-full bg-black border border-brand-border rounded px-3 py-1.5 text-zinc-200 focus:outline-none focus:border-emerald-500">
                        <option value="4GB">4.0 GB VRAM / Context</option>
                        <option value="8GB" selected>8.0 GB VRAM / Context</option>
                        <option value="16GB">16.0 GB VRAM / Context</option>
                    </select>
                </div>

                <div class="pt-2 flex justify-end space-x-2">
                    <button type="button" onclick="closeDeployModal()" class="px-3 py-1.5 rounded border border-brand-border text-zinc-400 hover:text-white hover:bg-zinc-900 transition-colors">CANCEL</button>
                    <button type="submit" class="px-4 py-1.5 rounded bg-emerald-500 hover:bg-emerald-400 text-black font-bold transition-colors">INITIALIZE & DEPLOY</button>
                </div>
            </form>
        </div>
    </div>

    <!-- APPLICATION STATE & LOGIC -->
    <script>
        // State Store
        const state = {
            selectedAgentId: 'agent-1',
            viewMode: 'carousel', // 'carousel' or 'compact'
            autoScroll: true,
            isPaused: false,
            killSwitchStage: 0, // 0 = default, 1 = confirm tap
            logSpeed: 1200,
            logFilter: '',
            agents: [
                {
                    id: 'agent-1',
                    name: 'ARCH-AGENT-01',
                    role: 'System Architecture Refactoring & AST Parsing',
                    status: 'RUNNING', // RUNNING, THINKING, PAUSED, KILLED
                    model: 'claude-3-5-sonnet',
                    memory: '4.2GB / 8.0GB',
                    throughput: 1420,
                    temp: 0.20,
                    topP: 0.90,
                    tokens: 4096,
                    tools: ['Bash', 'AST', 'Git'],
                    history: [12, 18, 25, 30, 45, 38, 52, 60, 48, 55, 70, 65, 80, 75, 90]
                },
                {
                    id: 'agent-2',
                    name: 'SEC-AUDIT-SWARM',
                    role: 'Vulnerability Detection & Static Analysis',
                    status: 'THINKING',
                    model: 'deepseek-r1',
